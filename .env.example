# Copy this file to ".env" and fill in the values. Never commit your real .env.

# ---- Discord ----
# Your bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=your-bot-token-here

# Optional but recommended for a personal bot: your server (guild) ID.
# When set, slash commands sync to this server INSTANTLY instead of taking up to
# an hour to appear globally. Enable Developer Mode in Discord, right-click your
# server icon -> "Copy Server ID".
GUILD_ID=

# Optional: seconds of idle time (paused / nothing to play) before the bot
# leaves the voice channel on its own. Defaults to 180 (3 minutes).
INACTIVE_TIMEOUT=180

# Optional: volume (0-1000, 100 = normal) applied whenever the bot joins a
# voice channel. Updated automatically by the /defaultvolume command.
DEFAULT_VOLUME=100

# ---- MusicGang desktop app / control API ----
# Port of the bot's control API, used by the MusicGang window. Default 27432.
WEB_PORT=27432

# Where the API listens:
#   127.0.0.1  this PC only (default, no password needed)
#   tailscale  this PC + its Tailscale IP, so friends on your tailnet can use
#              their MusicGang window against your bot. Needs WEB_TOKEN.
WEB_HOST=127.0.0.1

# Password every MusicGang window must give when WEB_HOST=tailscale. Share it
# with your friends privately. Any long random string.
WEB_TOKEN=

# Shared hosting with friends (see README "Let friends control it"):
# comma-separated Tailscale IPs of EVERY PC in the group, including your own
# ("tailscale ip -4" on each). Whoever opens the MusicGang window first hosts
# the bot; if they close it, the lowest IP still open takes over and the
# queue continues. Everyone in the list needs the full setup (Java, Lavalink,
# this .env with the same DISCORD_TOKEN and WEB_TOKEN).
MUSICGANG_PEERS=

# Alternative for a friend who should NEVER host (no Java/Lavalink on their
# PC): the host's Tailscale IP. The window only ever connects there.
MUSICGANG_HOST=

# ---- Lavalink ----
# Where your local Lavalink server is listening. The defaults match the included
# application.yml.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
